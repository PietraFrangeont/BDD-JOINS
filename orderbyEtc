A) 
   SELECT *
   FROM vendas
   ORDER BY Valor DESC;

B)
   SELECT Categoria, AVG(Valor) 
   FROM vendas
   GROUP BY Categoria;

C)
  SELECT Categoria, AVG(Valor)
  FROM vendas
  GROUP BY Categoria
  HAVING AVG(Valor) > 200;

D) 
  SELECT Produto, Valor
  FROM vendas
  WHERE Valor > (SELECT AVG(Valor) FROM vendas);
